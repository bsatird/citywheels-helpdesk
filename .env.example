# Copy this file to `.env` and fill in the values. Never commit the real `.env`.

# Which provider preset to use: gemini | openai | github | ollama
LLM_PROVIDER=gemini

# API key for the provider. For gemini this is the AI Studio key (starts with "AIza...").
# The name below matches the preset's expected variable, but LLM_API_KEY always wins.
GEMINI_API_KEY=
LLM_API_KEY=

# Optional overrides. Leave empty to use the preset defaults.
#   gemini -> gemini-3.5-flash, https://generativelanguage.googleapis.com/v1beta/openai
#             (gemini-flash-lite-latest works too and has a friendlier free tier)
#   github -> openai/gpt-4o-mini, https://models.github.ai/inference
#             (GitHub Models was retired on 2026-07-30 - kept as a preset example,
#              set LLM_BASE_URL to another compatible host to reuse it)
#   ollama -> qwen2.5:7b,          http://localhost:11434/v1
LLM_MODEL=
LLM_BASE_URL=

# Optional: minimum seconds between two model calls. Free Gemini keys allow only
# ~5 requests/minute, and every agent answer is 2-3 calls, so a value like 13
# turns "429 rate limited" into a slightly slower but successful run.
# 0 (default) means "as fast as the provider allows".
LLM_MIN_INTERVAL=

# Optional: temperature (default 0 - the agent should be deterministic).
LLM_TEMPERATURE=

# Fixed "current date" used by the agent (see README.md, "The data"). Leave empty
# for the default 2026-06-10T09:00:00+02:00. Tests and the evaluation override it.
CITYWHEELS_NOW=

# Optional: where the shop data lives (defaults to ./data).
CITYWHEELS_DATA_DIR=
